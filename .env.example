# Chat / evaluation models. Leave empty to run the offline pipeline.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_EVAL_MODEL=gpt-4o-mini
OPENAI_GEN_MODEL=gpt-4o
OPENAI_REWRITE_MODEL=gpt-4o

# Optional web search for the CRAG correction step.
TAVILY_API_KEY=

# Embeddings: auto | hashing | openai
# auto uses EMBEDDING_BASE_URL when set, otherwise deterministic hashing vectors.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=0

# Vector store
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=rail_crag

# Retrieval: hybrid (BM25 + vector + RRF) | bm25 | vector
RETRIEVER_K=5
RETRIEVAL_MODE=hybrid
RRF_K=60
RETRIEVAL_POOL=20
RAG_RERANK=1
SEARCH_K=5

# CRAG relevance thresholds
CRAG_UPPER_THRESHOLD=0.5
CRAG_LOWER_THRESHOLD=-0.5
